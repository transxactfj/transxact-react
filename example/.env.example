# Copy to .env.local. Use an sk_test_ key: Test mode runs simulated payments and moves no money.
TRANSXACT_SECRET_KEY=sk_test_...
TRANSXACT_API_URL=
TRANSXACT_WEBHOOK_SECRET=whsec_...
# Public https origin of this app (for example a tunnel URL). Checkout returns the Customer to ${PUBLIC_BASE_URL}/checkout/return
PUBLIC_BASE_URL=https://<your-tunnel>
