{
    "name": "@transxact/react",
    "version": "0.1.0",
    "description": "React hooks and components for Transxact hosted Checkout Sessions",
    "type": "module",
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "import": {
                "types": "./dist/index.d.ts",
                "default": "./dist/index.js"
            },
            "require": {
                "types": "./dist/index.d.cts",
                "default": "./dist/index.cjs"
            }
        },
        "./package.json": "./package.json"
    },
    "sideEffects": false,
    "files": [
        "dist",
        "README.md",
        "LICENSE"
    ],
    "repository": {
        "type": "git",
        "url": "git+https://github.com/transxactfj/transxact-react.git"
    },
    "scripts": {
        "build": "tsdown",
        "typecheck": "tsc --noEmit",
        "test": "vitest run",
        "test:watch": "vitest",
        "lint": "biome check .",
        "lint:fix": "biome check --write .",
        "check:pack": "node scripts/check-pack.mjs",
        "ci": "npm run lint && npm run typecheck && npm run test && npm run build && npm run check:pack",
        "release": "npm run build && changeset publish"
    },
    "keywords": [
        "transxact",
        "react",
        "payments",
        "checkout",
        "fiji",
        "mpaisa",
        "mycash"
    ],
    "license": "Apache-2.0",
    "publishConfig": {
        "access": "public",
        "provenance": true
    },
    "peerDependencies": {
        "react": ">=18"
    },
    "devDependencies": {
        "@biomejs/biome": "^2.5.14",
        "@changesets/changelog-github": "^1.0.1",
        "@changesets/cli": "^3.0.3",
        "@testing-library/react": "^16.3.3",
        "@transxact/node": "^0.4.45",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "jsdom": "^29.1.1",
        "react": "^19.3.0",
        "react-dom": "^19.3.0",
        "tsdown": "^0.21.10",
        "typescript": "^6.0.3",
        "vitest": "^5.0.2"
    }
}
